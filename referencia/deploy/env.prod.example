# Copiar al servidor como /opt/biblioteca/.env con permisos 600. Nunca al repositorio.
DOMINIO=biblioteca.ejemplo.com
# Imagen sin etiqueta: "biblioteca" si se cargó con docker load (semana 4),
# o la del registro, por ejemplo ghcr.io/<usuario>/biblioteca (semana 7).
IMAGEN=biblioteca
APP_VERSION=1.0.0
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=cambiar-por-una-clave-larga-y-aleatoria
POSTGRES_DB=biblioteca
# Dónde corre desplegar.sh la prueba de humo después de cambiar de versión.
URL_APP=https://biblioteca.ejemplo.com
